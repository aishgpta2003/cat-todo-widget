<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:orientation="horizontal"
    android:gravity="center_vertical" android:padding="4dp">

    <ImageView android:id="@+id/bar" android:layout_width="6dp" android:layout_height="40dp"/>
    <ImageView android:id="@+id/sticker" android:layout_width="40dp" android:layout_height="40dp"
        android:layout_marginStart="8dp" android:scaleType="fitCenter"/>
    <ImageView android:id="@+id/text" android:layout_width="0dp" android:layout_height="40dp"
        android:layout_weight="1" android:layout_marginStart="8dp" android:scaleType="fitStart"/>
</LinearLayout>